{
  "name": "acm-website-tanstack",
  "private": true,
  "type": "module",
  "scripts": {
    "container:up": "docker compose up -d",
    "container:down": "docker compose down -v",
    "dev:app": "vite dev",
    "dev": "concurrently -n 'api,app' -c blue,green,magenta 'pnpm container:up' 'pnpm dev:app'",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "pnpm run fmt:check && pnpm run lint",
    "check:write": "pnpm run fmt && pnpm run lint:fix",
    "prepare": "husky",
    "email:dev": "email dev --dir=./src/emails --port=2999"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/eden": "^1.4.8",
    "@elysiajs/openapi": "^1.4.14",
    "@fontsource/space-grotesk": "^5.2.10",
    "@netlify/vite-plugin-tanstack-start": "^1.3.2",
    "@react-email/components": "1.0.10",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-form-start": "^1.28.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-devtools": "^5.95.2",
    "@tanstack/react-router": "^1.168.3",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@tanstack/react-router-ssr-query": "^1.166.10",
    "@tanstack/react-start": "^1.167.5",
    "@tanstack/router-plugin": "^1.167.4",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.4",
    "elysia": "^1.4.28",
    "nodemailer": "^8.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.10",
    "@rollup/plugin-yaml": "^4.1.2",
    "@tanstack/devtools-vite": "^0.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260324.1",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "oxlint-tsgolint": "^0.17.3",
    "react-email": "5.2.10",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-imagetools": "^9.0.2",
    "vitest": "^4.1.0",
    "web-vitals": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
