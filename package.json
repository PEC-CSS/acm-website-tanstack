    "@logtape/pretty": "^2.0.5",
    "@netlify/vite-plugin-tanstack-start": "^1.0.2",
    "@react-email/components": "^1.0.2",
    "@t3-oss/env-core": "^0.13.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.7.0",
