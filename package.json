{
  "name": "acm-website-tanstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "pnpm run fmt:check && pnpm run lint",
    "check:write": "pnpm run fmt && pnpm run lint:fix",
